*.db
*.db-journal
*.db-wal
*.db-shm
# Local config and per-deployment DH keys
# keys.txt is this deployment's DH prime/private/public, produced by
# tools/gen-dhm-keys.py. It is machine-specific and must never be published.
# (The same default values also live in code/OpenTyria/main.c:32,38 --
# tracked as docs/03-roadmap.md milestone 2, item 1.)
config.local.*
keys.txt
keys.local.txt
# Packet captures from tools/sniff-capture.py. Even sanitised, these are working
# files; a golden capture gets committed deliberately and reviewed first.
captures/
user/
logs/
*.log

# ---- editors / tooling ----
.vs/
.vscode/
__pycache__/
*.pyc
.idea/

# ---- reference clone of upstream, not part of this project ----
.ref-opentyria/
